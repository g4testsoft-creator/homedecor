<div class="product-card-wrapper">
  <div class="decor-card">
    <%= link_to product_path(item), class: "decor-card-link" do %>
      <% if item.images.attached? && item.images.first.present? %>
        <div class="card-image">
          <%= image_tag item.images.first, alt: item.name, class: "card-img" %>
        </div>
      <% else %>
        <div class="card-image">
          <img src="https://via.placeholder.com/400x300?text=No+Image" alt="<%= item.name %>" class="card-img">
        </div>
      <% end %>

      <% unless item.in_stock? %>
        <div class="out-of-stock-badge">Out of Stock</div>
      <% end %>

      <div class="card-content">
        <h3 class="card-title"><%= item.name %></h3>

        <% if item.description.present? %>
          <p class="card-description"><%= truncate(item.description, length: 80) %></p>
        <% end %>
      </div>
    <% end %>

    <div class="card-price-row">
      <% if item.price.present? %>
        <div class="card-price">
          <strong>Rs. <%= item.price.to_i %></strong>
        </div>
      <% end %>
      <%= render "shared/cart_action", product: item, style: :compact %>
    </div>
  </div>
</div>

<style>
  .product-card-wrapper {
    height: 100%;
    display: flex;
  }

  .decor-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
  }

  .decor-card-link {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-image {
    position: relative;
  }

  @media (max-width: 768px) {
    .card-image {
      height: 311px;
    }
  }

  .out-of-stock-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(198, 40, 40, 0.95);
    color: white;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 12px rgba(198, 40, 40, 0.3);
    backdrop-filter: blur(4px);
    z-index: 10;
  }
</style>

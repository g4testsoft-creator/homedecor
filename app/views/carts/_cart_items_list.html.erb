<div id="cart_items_list" class="cart-items-section">
  <% cart_items.each do |cart_item| %>
    <div class="cart-item" id="cart-item-<%= cart_item.product_id %>">
      <% if cart_item.product.images.attached? %>
        <div class="cart-item-image">
          <%= image_tag cart_item.product.images.first, alt: cart_item.product.name %>
        </div>
      <% else %>
        <div class="cart-item-image" style="background: #f0f0f0;"></div>
      <% end %>

      <div class="cart-item-details">
        <%= link_to cart_item.product.name, product_path(cart_item.product), class: "cart-item-name" %>
        <p class="cart-item-price"><%= format_price(cart_item.product.price) %> each</p>
      </div>

      <div class="cart-item-controls">
        <div class="cart-action cart-action-compact"
             data-controller="cart-stepper"
             data-cart-stepper-product-id-value="<%= cart_item.product_id %>"
             data-cart-stepper-quantity-value="<%= cart_item.quantity %>"
             data-cart-stepper-update-url-value="<%= update_quantity_cart_path %>">
          <div class="cart-stepper">
            <button type="button"
                    class="cart-stepper-btn cart-stepper-decrement"
                    data-cart-stepper-target="decrementButton"
                    data-action="click->cart-stepper#decrement"
                    aria-label="Decrease quantity">−</button>
            <span class="cart-stepper-value" data-cart-stepper-target="quantity"><%= cart_item.quantity %></span>
            <button type="button"
                    class="cart-stepper-btn cart-stepper-increment"
                    data-cart-stepper-target="incrementButton"
                    data-action="click->cart-stepper#increment"
                    aria-label="Increase quantity">+</button>
          </div>
        </div>

        <%= button_to "Remove",
                      remove_item_cart_path(product_id: cart_item.product_id),
                      method: :delete,
                      class: "remove-btn",
                      form: { data: { turbo_confirm: "Remove this item from the cart?" } } %>
      </div>

      <div class="cart-item-total">
        <%= format_price(cart_item.total_price) %>
      </div>
    </div>
  <% end %>
</div>
